{
  "name": "lembed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "discord cards with real link buttons, self-hosted",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vendor": "node scripts/vendor.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@melloware/coloris": "0.25.2",
    "cheerio": "^1.1.2",
    "codemirror": "5.65.21",
    "emoji-picker-element": "1.29.1",
    "emoji-picker-element-data": "1.8.0",
    "ipaddr.js": "^2.2.0",
    "lucide-static": "1.73.0",
    "markdown-it": "^15.0.3",
    "sortablejs": "1.15.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  }
}
